# Leave empty in development (Vite proxies /api and /socket.io to localhost:5000).
# In production set to your API origin, e.g. https://civicconnect-api.onrender.com
VITE_API_URL=
# Map tiles. The default is the public OpenStreetMap server, which is fine for light/dev use only
# (see https://operations.osmfoundation.org/policies/tiles/). For production traffic use a hosted provider
# (MapTiler, Stadia, Thunderforest, ...) and set its URL + attribution here.
VITE_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
# Default map centre as "lat,lng"
VITE_DEFAULT_CENTER=18.5204,73.8567
