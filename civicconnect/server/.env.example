NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/civicconnect
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=7858360fa5b60ae13825846829f697225a087f298743f4c486b578b67195
JWT_REFRESH_SECRET=95edfd3585112f04d5429d95f643b1f7566f
# Comma-separated list of exact frontend origins
CLIENT_ORIGIN=http://localhost:5173
# Cookies: in production use SameSite=none (cross-domain) or lax (same site, e.g. app.x.com + api.x.com)
COOKIE_SAMESITE=
COOKIE_DOMAIN=
PUBLIC_URL=http://localhost:5000
# Cloudinary (required in production)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Workflow rules
REOPEN_WINDOW_DAYS=14
REQUIRE_CLOSURE=true
# Geocoding (Nominatim usage policy requires an identifying User-Agent with contact)
NOMINATIM_URL=https://nominatim.openstreetmap.org
GEOCODER_USER_AGENT=CivicConnect/1.0 (contact: you@example.com)
